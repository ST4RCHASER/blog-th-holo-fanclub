---
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header
  class="fixed top-0 left-0 w-full z-30 bg-white/90 dark:bg-gray-900/90 backdrop-blur-xl shadow-2xl border-b border-pink-200/50 dark:border-pink-500/30 transition-all duration-300"
>
  <div
    class="absolute inset-0 bg-gradient-to-r from-pink-50/50 via-blue-50/50 to-yellow-50/50 dark:from-gray-800/50 dark:via-blue-800/50 dark:to-purple-800/50"
  >
  </div>
  <nav
    class="container mx-auto px-4 py-4 flex items-center justify-between relative z-10 sm:px-6 lg:px-8"
  >
    <div class="flex items-center gap-4">
      <a href="https://th.holofan.club/" class="group relative">
        <!-- Logo Container -->
        <div class="flex items-center gap-3">
          <!-- Logo Icon -->
          <div class="relative">
            <img
              src="/web-app-manifest-192x192.png"
              alt="HoloFans TH"
              class="w-10 h-10 object-contain transition-all duration-300 group-hover:scale-110 group-hover:drop-shadow-lg"
            />
          </div>

          <!-- Logo Text -->
          <div class="hidden sm:block">
            <div
              class="text-xl font-bold bg-gradient-to-r from-pink-400 via-blue-400 to-yellow-400 bg-clip-text text-transparent transition-all duration-300 group-hover:scale-105"
            >
              HoloFans TH
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-300 font-medium">
              Archive blogs
            </div>
          </div>
        </div>

        <!-- Hover underline -->
        <div
          class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-pink-400 to-blue-400 transition-all duration-300 group-hover:w-full"
        >
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      <Navigation />
      <div
        class="w-px h-6 bg-gradient-to-b from-transparent via-pink-300 dark:via-pink-500 to-transparent"
      >
      </div>
      <ThemeIcon />
    </div>

    <!-- Mobile Navigation -->
    <div class="md:hidden flex items-center gap-4">
      <ThemeIcon />
      <div
        class="w-px h-6 bg-gradient-to-b from-transparent via-pink-300 dark:via-pink-500 to-transparent"
      >
      </div>
      <Hamburger />
    </div>
  </nav>
</header>

<!-- Mobile Drawer Overlay -->
<div
  id="mobileOverlay"
  class="fixed inset-0 bg-black/50 dark:bg-black/70 z-40 hidden md:hidden transition-opacity duration-300"
>
</div>

<!-- Mobile Navigation Drawer -->
<div
  id="mobileDrawer"
  class="fixed top-0 right-0 h-full w-80 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden"
>
  <Navigation />
</div>
