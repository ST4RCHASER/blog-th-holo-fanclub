---
const { platform, username } = Astro.props
---

<a href={`https://www.${platform}.com/${username}`} class="text-sm hover:underline transition-all duration-200 hover:text-pink-200">
  {platform}
</a>

<style>
  a {
    padding: 0.5rem 1rem;
    color: white;
    background-color: #4c1d95;
    text-decoration: none;
  }
</style>
