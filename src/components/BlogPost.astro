---
const { title, url } = Astro.props;
---

<div class="p-6">
  <h3 class="text-xl font-bold mb-4 text-gray-800 dark:text-gray-100">
    <a
      href={url}
      class="hover:text-pink-600 dark:hover:text-pink-400 transition-colors duration-200"
    >
      {title}
    </a>
  </h3>
  <div
    class="h-32 bg-gradient-to-br from-pink-200 to-blue-200 dark:from-pink-900/30 dark:to-blue-900/30 rounded-lg mb-4"
  >
  </div>
  <a
    href={url}
    class="text-pink-400 dark:text-pink-300 font-bold hover:text-pink-600 dark:hover:text-pink-400 transition-colors duration-200"
  >
    Read More →
  </a>
</div>
