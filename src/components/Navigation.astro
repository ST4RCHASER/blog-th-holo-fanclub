<!-- Desktop Navigation -->
<div class="nav-links hidden md:flex items-center gap-8">
  <a
    href="https://th.holofan.club"
    class="
    group
    relative
    px-4
    py-2
    text-pink-400
    dark:text-pink-300
    font-bold
    hover:text-pink-600
    dark:hover:text-pink-400
    transition-all
    duration-300
    drop-shadow-[0_0_8px_white]
    dark:drop-shadow-[0_0_0px_black]"
  >
    <span class="relative z-10">HOME</span>
    <div
      class="absolute inset-0 bg-gradient-to-r from-pink-100 to-blue-100 dark:from-pink-900/30 dark:to-blue-900/30 rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-95 group-hover:scale-100"
    >
    </div>
    <div
      class="absolute -bottom-1 left-1/2 w-0 h-0.5 bg-gradient-to-r from-pink-400 to-blue-400 transition-all duration-300 group-hover:w-full group-hover:left-0"
    >
    </div>
  </a>
  <a
    href="/blog/"
    class="group relative px-4 py-2 text-pink-400 dark:text-pink-300 font-bold hover:text-pink-600 dark:hover:text-pink-400 transition-all duration-300 drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_0px_black]"
  >
    <span class="relative z-10">BLOG</span>
    <div
      class="absolute inset-0 bg-gradient-to-r from-blue-100 to-yellow-100 dark:from-blue-900/30 dark:to-yellow-900/30 rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-95 group-hover:scale-100"
    >
    </div>
    <div
      class="absolute -bottom-1 left-1/2 w-0 h-0.5 bg-gradient-to-r from-blue-400 to-yellow-400 transition-all duration-300 group-hover:w-full group-hover:left-0"
    >
    </div>
  </a>
  <a
    href="/tags/"
    class="group relative px-4 py-2 text-pink-400 dark:text-pink-300 font-bold hover:text-pink-600 dark:hover:text-pink-400 transition-all duration-300 drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_0px_black]"
  >
    <span class="relative z-10">TAGS</span>
    <div
      class="absolute inset-0 bg-gradient-to-r from-yellow-100 to-pink-100 dark:from-yellow-900/30 dark:to-pink-900/30 rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-95 group-hover:scale-100"
    >
    </div>
    <div
      class="absolute -bottom-1 left-1/2 w-0 h-0.5 bg-gradient-to-r from-yellow-400 to-pink-400 transition-all duration-300 group-hover:w-full group-hover:left-0"
    >
    </div>
  </a>
</div>

<!-- Mobile Navigation Drawer Content -->
<div class="md:hidden h-full flex flex-col">
  <!-- Drawer Header -->
  <div class="p-6 border-b border-pink-200/50 dark:border-pink-500/30">
    <div class="flex items-center justify-between">
      <h2
        class="text-xl font-bold bg-gradient-to-r from-pink-400 to-blue-400 bg-clip-text text-transparent"
      >
        Menu
      </h2>
      <button
        id="closeDrawerBtn"
        class="p-2 hover:bg-pink-50 dark:hover:bg-pink-900/30 rounded-lg transition-colors duration-200 group"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-pink-400 dark:text-pink-300 group-hover:text-pink-600 dark:group-hover:text-pink-400 transition-colors duration-200"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Navigation Links -->
  <div class="flex-1 p-6 space-y-4">
    <a
      href="/"
      class="group block relative px-4 py-4 text-pink-400 dark:text-pink-300 font-bold hover:text-pink-600 dark:hover:text-pink-400 transition-all duration-300 rounded-xl hover:bg-gradient-to-r hover:from-pink-50 hover:to-blue-50 dark:hover:from-pink-900/30 dark:hover:to-blue-900/30"
    >
      <span class="relative z-10 flex items-center gap-4">
        <div
          class="w-3 h-3 bg-pink-400 dark:bg-pink-300 rounded-full group-hover:scale-150 transition-transform duration-300"
        >
        </div>
        <span class="text-lg">HOME</span>
      </span>
      <div
        class="absolute left-0 bottom-0 w-0 h-0.5 bg-gradient-to-r from-pink-400 to-blue-400 transition-all duration-300 group-hover:w-full"
      >
      </div>
    </a>
    <a
      href="/blog/"
      class="group block relative px-4 py-4 text-pink-400 dark:text-pink-300 font-bold hover:text-pink-600 dark:hover:text-pink-400 transition-all duration-300 rounded-xl hover:bg-gradient-to-r hover:from-blue-50 hover:to-yellow-50 dark:hover:from-blue-900/30 dark:hover:to-yellow-900/30"
    >
      <span class="relative z-10 flex items-center gap-4">
        <div
          class="w-3 h-3 bg-blue-400 dark:bg-blue-300 rounded-full group-hover:scale-150 transition-transform duration-300"
        >
        </div>
        <span class="text-lg">BLOG</span>
      </span>
      <div
        class="absolute left-0 bottom-0 w-0 h-0.5 bg-gradient-to-r from-blue-400 to-yellow-400 transition-all duration-300 group-hover:w-full"
      >
      </div>
    </a>
    <a
      href="/tags/"
      class="group block relative px-4 py-4 text-pink-400 dark:text-pink-300 font-bold hover:text-pink-600 dark:hover:text-pink-400 transition-all duration-300 rounded-xl hover:bg-gradient-to-r hover:from-yellow-50 hover:to-pink-50 dark:hover:from-yellow-900/30 dark:hover:to-pink-900/30"
    >
      <span class="relative z-10 flex items-center gap-4">
        <div
          class="w-3 h-3 bg-yellow-400 dark:bg-yellow-300 rounded-full group-hover:scale-150 transition-transform duration-300"
        >
        </div>
        <span class="text-lg">TAGS</span>
      </span>
      <div
        class="absolute left-0 bottom-0 w-0 h-0.5 bg-gradient-to-r from-yellow-400 to-pink-400 transition-all duration-300 group-hover:w-full"
      >
      </div>
    </a>
  </div>

  <!-- Drawer Footer -->
  <div class="p-6 border-t border-pink-200/50 dark:border-pink-500/30">
    <div class="text-center">
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">Holo Fans TH</p>
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Beautiful theme inspired by th-holo-fanclub
      </p>
    </div>
  </div>
</div>
