---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={`${frontmatter.title} - Holo Fans TH`}>
  <!-- Hero Section -->
  <section class="relative py-16 mb-16">
    <div class="relative py-12 w-fit mx-auto mb-8">
      <div
        class="absolute z-10 w-full flex flex-col items-center mt-12 font-black text-3xl drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_8px_black] text-gray-800 dark:text-gray-100"
      >
        POST
      </div>
      <div
        class="text-8xl mt-4 opacity-40 font-black bg-gradient-to-r from-pink-400 via-blue-400 to-yellow-400 bg-clip-text text-transparent drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_8px_black]"
      >
        投稿
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="content slide-in max-w-4xl mx-auto">
    <!-- Post Header -->
    <div
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-8 mb-8"
    >
      <!-- Title -->
      <h1
        class="text-4xl md:text-5xl font-bold mb-6 text-gray-800 dark:text-gray-100 bg-gradient-to-r from-pink-400 to-blue-400 bg-clip-text text-transparent"
      >
        {frontmatter.title}
      </h1>

      <!-- Description -->
      {
        frontmatter.description && (
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-6 italic">
            {frontmatter.description}
          </p>
        )
      }

      <!-- Meta Information -->
      <div class="flex flex-wrap items-center gap-6 mb-6">
        <!-- Date -->
        <div class="flex items-center gap-2">
          <div
            class="w-3 h-3 bg-gradient-to-r from-pink-400 to-blue-400 rounded-full"
          >
          </div>
          <span class="text-gray-600 dark:text-gray-300 font-medium">
            {
              new Date(frontmatter.pubDate).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </span>
        </div>

        <!-- Author -->
        {
          frontmatter.author && (
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 bg-gradient-to-r from-blue-400 to-yellow-400 rounded-full" />
              <span class="text-gray-600 dark:text-gray-300 font-medium">
                By {frontmatter.author}
              </span>
            </div>
          )
        }
      </div>

      <!-- Featured Image -->
      {
        frontmatter.image && (
          <div class="relative rounded-xl overflow-hidden mb-6 shadow-lg">
            <img
              src={frontmatter.image.url}
              alt={frontmatter.image.alt || frontmatter.title}
              class="w-full h-64 md:h-80 object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
          </div>
        )
      }

      <!-- Tags -->
      {
        frontmatter.tags && frontmatter.tags.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {frontmatter.tags.map((tag: string) => (
              <a
                href={`/tags/${tag}`}
                class="group px-4 py-2 bg-gradient-to-r from-pink-100 to-blue-100 dark:from-pink-900/50 dark:to-blue-900/50 text-gray-700 dark:text-gray-200 rounded-full hover:from-pink-200 hover:to-blue-200 dark:hover:from-pink-800/70 dark:hover:to-blue-800/70 transition-all duration-300 shadow-md hover:shadow-lg hover:scale-105"
              >
                <span class="flex items-center gap-2">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="text-pink-500 dark:text-pink-400"
                  >
                    <path
                      d="M20.59 13.41L13.42 20.58C13.2343 20.766 13.0137 20.9135 12.7709 21.0141C12.5281 21.1148 12.2678 21.1666 12.005 21.1666C11.7422 21.1666 11.4819 21.1148 11.2391 21.0141C10.9963 20.9135 10.7757 20.766 10.59 20.58L2 12V2H12L20.59 10.59C20.9625 10.9625 21.1666 11.4696 21.1666 12C21.1666 12.5304 20.9625 13.0375 20.59 13.41Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {tag}
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- Post Content -->
    <div
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-8 mb-8"
    >
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>
    </div>

    <!-- Navigation -->
    <div
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-6"
    >
      <div class="flex flex-col sm:flex-row gap-4 justify-between items-center">
        <a
          href="/blog/"
          class="flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-gray-400 to-gray-500 text-white font-bold rounded-lg hover:from-gray-500 hover:to-gray-600 transition-all duration-300 shadow-lg hover:shadow-xl"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            class="text-white"
          >
            <path
              d="M19 12H5M5 12L12 19M5 12L12 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back to Blog
        </a>

        <div class="flex gap-3">
          <a
            href="/tags/"
            class="px-6 py-3 bg-gradient-to-r from-pink-400 to-blue-400 text-white font-bold rounded-lg hover:from-pink-500 hover:to-blue-500 transition-all duration-300 shadow-lg hover:shadow-xl"
          >
            Browse Tags
          </a>
          <a
            href="/"
            class="px-6 py-3 bg-gradient-to-r from-yellow-400 to-pink-400 text-white font-bold rounded-lg hover:from-yellow-500 hover:to-pink-500 transition-all duration-300 shadow-lg hover:shadow-xl"
          >
            Home
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Typography enhancements with dark mode support */
  .prose {
    color: #374151;
    line-height: 1.75;
  }

  .dark .prose {
    color: #ffffff !important;
  }

  .prose h1 {
    color: #1f2937;
    font-size: 2.25rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #ec4899, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .dark .prose h1 {
    color: #ffffff !important;
    -webkit-text-fill-color: transparent;
  }

  .prose h2 {
    color: #1f2937;
    font-size: 1.875rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    border-left: 4px solid #ec4899;
    padding-left: 1rem;
  }

  .dark .prose h2 {
    color: #ffffff !important;
    border-left-color: #ec4899;
  }

  .prose h3 {
    color: #374151;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .dark .prose h3 {
    color: #ffffff !important;
  }

  .prose h4 {
    color: #374151;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .dark .prose h4 {
    color: #ffffff !important;
  }

  .prose h5 {
    color: #374151;
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .dark .prose h5 {
    color: #ffffff !important;
  }

  .prose h6 {
    color: #374151;
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .dark .prose h6 {
    color: #ffffff !important;
  }

  .prose p {
    margin-bottom: 1.25rem;
    text-align: justify;
    color: #374151;
  }

  .dark .prose p {
    color: #ffffff !important;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: #374151;
  }

  .dark .prose li {
    color: #ffffff !important;
  }

  .prose ul li::marker {
    color: #ec4899;
  }

  .dark .prose ul li::marker {
    color: #f472b6 !important;
  }

  .prose ol li::marker {
    color: #3b82f6;
    font-weight: 600;
  }

  .dark .prose ol li::marker {
    color: #60a5fa !important;
  }

  .prose blockquote {
    border-left: 4px solid #ec4899;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    background: linear-gradient(135deg, #fdf2f8, #eff6ff);
    padding: 1.5rem;
    border-radius: 0.5rem;
    color: #374151;
  }

  .dark .prose blockquote {
    background: linear-gradient(135deg, #1f2937, #111827);
    border-left-color: #ec4899;
    color: #ffffff !important;
  }

  .prose code {
    background: linear-gradient(135deg, #fdf2f8, #eff6ff);
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-family: "Fira Code", monospace;
    color: #ec4899;
    font-weight: 500;
  }

  .dark .prose code {
    background: linear-gradient(135deg, #1f2937, #111827);
    color: #f472b6 !important;
  }

  .prose pre {
    background: #1f2937;
    color: #f9fafb;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid #374151;
  }

  .dark .prose pre {
    background: #111827;
    border-color: #4b5563;
  }

  .prose pre code {
    background: none;
    padding: 0;
    color: inherit;
    font-weight: normal;
  }

  .prose a {
    color: #ec4899;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
  }

  .dark .prose a {
    color: #f472b6 !important;
  }

  .prose a:hover {
    color: #3b82f6;
    border-bottom-color: #3b82f6;
  }

  .dark .prose a:hover {
    color: #60a5fa !important;
    border-bottom-color: #60a5fa;
  }

  .prose strong {
    color: #1f2937;
    font-weight: 700;
  }

  .dark .prose strong {
    color: #ffffff !important;
  }

  .prose em {
    color: #6b7280;
    font-style: italic;
  }

  .dark .prose em {
    color: #e5e7eb !important;
  }

  .prose img {
    border-radius: 0.75rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    margin: 1.5rem 0;
  }

  .dark .prose img {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .dark .prose table {
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  }

  .prose th {
    background: linear-gradient(135deg, #ec4899, #3b82f6);
    color: white;
    padding: 0.75rem;
    text-align: left;
    font-weight: 600;
  }

  .prose td {
    padding: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
    color: #374151;
  }

  .dark .prose td {
    border-bottom-color: #4b5563;
    color: #ffffff !important;
  }

  .prose tr:nth-child(even) {
    background-color: #f9fafb;
  }

  .dark .prose tr:nth-child(even) {
    background-color: #1f2937;
  }

  .prose tr:hover {
    background-color: #f3f4f6;
  }

  .dark .prose tr:hover {
    background-color: #374151;
  }

  .prose hr {
    border-color: #e5e7eb;
    margin: 2rem 0;
  }

  .dark .prose hr {
    border-color: #4b5563;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .prose h1 {
      font-size: 1.875rem;
    }

    .prose h2 {
      font-size: 1.5rem;
    }

    .prose h3 {
      font-size: 1.25rem;
    }
  }
</style>
