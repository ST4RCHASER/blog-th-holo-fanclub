---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";

export async function getStaticPaths() {
  const allPosts = Object.values(
    import.meta.glob("../posts/*.md", { eager: true })
  );
  const tags = [
    ...new Set(allPosts.map((post: any) => post.frontmatter.tags).flat()),
  ];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const allPosts = Object.values(
  import.meta.glob("../posts/*.md", { eager: true })
);
const posts = allPosts.filter((post: any) =>
  post.frontmatter.tags.includes(tag)
);
const pageTitle = `Tag: ${tag} - Holo Fans TH`;
---

<BaseLayout pageTitle={pageTitle}>
  <!-- Hero Section -->
  <section class="relative py-16 mb-16">
    <div class="relative py-12 w-fit mx-auto mb-8">
      <div
        class="absolute z-10 w-full flex flex-col items-center mt-12 font-black text-3xl drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_8px_black]"
      >
        TAG
      </div>
      <div
        class="text-8xl mt-4 opacity-40 font-black bg-gradient-to-r from-pink-400 via-blue-400 to-yellow-400 bg-clip-text text-transparent drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_8px_black]"
      >
        タグ
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="content slide-in max-w-6xl mx-auto">
    <!-- Tag Header -->
    <div
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-8 mb-8"
    >
      <div class="flex items-center gap-4 mb-6">
        <div
          class="w-16 h-16 bg-gradient-to-br from-pink-400 to-blue-400 rounded-full flex items-center justify-center"
        >
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            class="text-white"
          >
            <path
              d="M20.59 13.41L13.42 20.58C13.2343 20.766 13.0137 20.9135 12.7709 21.0141C12.5281 21.1148 12.2678 21.1666 12.005 21.1666C11.7422 21.1666 11.4819 21.1148 11.2391 21.0141C10.9963 20.9135 10.7757 20.766 10.59 20.58L2 12V2H12L20.59 10.59C20.9625 10.9625 21.1666 11.4696 21.1666 12C21.1666 12.5304 20.9625 13.0375 20.59 13.41Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <div>
          <h1
            class="text-4xl font-bold text-gray-800 dark:text-gray-100 bg-gradient-to-r from-pink-400 to-blue-400 bg-clip-text text-transparent"
          >
            {tag}
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-400 mt-2">
            {posts.length} post{posts.length !== 1 ? "s" : ""} found
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <a
          href="/tags/"
          class="px-4 py-2 bg-gradient-to-r from-gray-400 to-gray-500 text-white font-medium rounded-lg hover:from-gray-500 hover:to-gray-600 transition-all duration-300 shadow-md hover:shadow-lg"
        >
          ← All Tags
        </a>
        <a
          href="/blog/"
          class="px-4 py-2 bg-gradient-to-r from-pink-400 to-blue-400 text-white font-medium rounded-lg hover:from-pink-500 hover:to-blue-500 transition-all duration-300 shadow-md hover:shadow-lg"
        >
          View All Posts
        </a>
      </div>
    </div>

    <!-- Posts Grid -->
    {
      posts.length > 0 ? (
        <div class="grid gap-8">
          {posts.map((post: any, index) => (
            <div
              class="animate-fade-in-up"
              style={`animation-delay: ${index * 0.1}s`}
            >
              <BlogPost url={post.url} title={post.frontmatter.title} />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <div class="text-6xl mb-4">📝</div>
          <h3 class="text-2xl font-bold mb-4 text-gray-800 dark:text-gray-100">
            No posts found
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-8">
            No blog posts found with the tag "{tag}".
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a
              href="/tags/"
              class="px-6 py-3 bg-gradient-to-r from-gray-400 to-gray-500 text-white font-bold rounded-lg hover:from-gray-500 hover:to-gray-600 transition-all duration-300 shadow-lg"
            >
              Browse All Tags
            </a>
            <a
              href="/blog/"
              class="px-6 py-3 bg-gradient-to-r from-pink-400 to-blue-400 text-white font-bold rounded-lg hover:from-pink-500 hover:to-blue-500 transition-all duration-300 shadow-lg"
            >
              View All Posts
            </a>
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
