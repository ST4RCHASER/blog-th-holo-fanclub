---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "500 - Server Error - HoloFans TH";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="content slide-in max-w-4xl mx-auto mt-24">
    <!-- 500 Hero Section -->
    <div class="text-center py-16 mb-16">
      <div class="relative py-12 w-fit mx-auto mb-8">
        <div
          class="absolute z-10 w-full flex flex-col items-center mt-12 font-black text-6xl drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_8px_black] text-red-400 dark:text-red-300"
        >
          500
        </div>
        <div
          class="text-9xl mt-4 opacity-40 font-black bg-gradient-to-r from-red-400 via-orange-400 to-yellow-400 bg-clip-text text-transparent drop-shadow-[0_0_8px_white] dark:drop-shadow-[0_0_8px_black]"
        >
          サーバー
        </div>
      </div>
    </div>

    <!-- Error Content -->
    <div
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-8 mb-8"
    >
      <div class="text-center">
        <div class="text-8xl mb-6">💥</div>
        <h1
          class="text-4xl font-bold mb-4 text-gray-800 dark:text-gray-100 bg-gradient-to-r from-red-400 to-orange-400 bg-clip-text text-transparent"
        >
          Server Error
        </h1>
        <p
          class="text-lg text-gray-700 dark:text-gray-300 mb-8 max-w-2xl mx-auto"
        >
          Something went wrong on our end. Our team has been notified and is
          working to fix the issue. Please try again in a few moments.
        </p>

        <!-- Status Info -->
        <div
          class="bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-900/30 dark:to-orange-900/30 rounded-lg p-6 mb-8"
        >
          <h3
            class="text-xl font-semibold mb-3 text-gray-800 dark:text-gray-100"
          >
            What happened?
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            This is a temporary server error. It's not your fault - something
            went wrong on our servers.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button
              onclick="window.location.reload()"
              class="px-6 py-3 bg-gradient-to-r from-red-400 to-orange-400 text-white font-bold rounded-lg hover:from-red-500 hover:to-orange-500 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              Try Again
            </button>
            <a
              href="/"
              class="px-6 py-3 border-2 border-red-400 text-red-400 dark:text-red-300 font-bold rounded-lg hover:bg-red-400 hover:text-white dark:hover:bg-red-400 dark:hover:text-white transition-all duration-300"
            >
              Go Home
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Check Status -->
      <div
        class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-6 text-center hover:scale-105 transition-all duration-300 border border-red-200/50 dark:border-red-500/30"
      >
        <div class="text-4xl mb-4">🔧</div>
        <h3 class="text-xl font-bold mb-2 text-gray-800 dark:text-gray-100">
          System Status
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Check if there are any ongoing issues
        </p>
        <a
          href="#"
          onclick="alert('Status page coming soon!')"
          class="inline-flex items-center gap-2 text-red-400 dark:text-red-300 font-bold hover:text-red-600 dark:hover:text-red-400 transition-colors duration-300"
        >
          Check Status
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            <path
              d="M5 12H19M19 12L12 5M19 12L12 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <!-- Contact Support -->
      <div
        class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-6 text-center hover:scale-105 transition-all duration-300 border border-red-200/50 dark:border-red-500/30"
      >
        <div class="text-4xl mb-4">📧</div>
        <h3 class="text-xl font-bold mb-2 text-gray-800 dark:text-gray-100">
          Contact Support
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Get help if the problem persists
        </p>
        <a
          href="mailto:support@holofansth.com?subject=Server Error - 500"
          class="inline-flex items-center gap-2 text-red-400 dark:text-red-300 font-bold hover:text-red-600 dark:hover:text-red-400 transition-colors duration-300"
        >
          Contact Us
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            <path
              d="M5 12H19M19 12L12 5M19 12L12 19"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Alternative Navigation -->
    <div
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-8"
    >
      <div class="text-center">
        <h3 class="text-xl font-bold mb-3 text-gray-800 dark:text-gray-100">
          While we fix this...
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          You can still access some parts of our site that might be working:
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/blog/"
            class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300"
          >
            Blog Archive
          </a>
          <a
            href="/tags/"
            class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300"
          >
            Categories
          </a>
          <a
            href="/api/docs"
            class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300"
          >
            API Docs
          </a>
        </div>
      </div>
    </div>

    <!-- Technical Details (Hidden by default) -->
    <details
      class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-lg p-6 mt-12"
    >
      <summary
        class="cursor-pointer text-gray-600 dark:text-gray-400 font-medium hover:text-gray-800 dark:hover:text-gray-200 transition-colors duration-300"
      >
        Technical Details
      </summary>
      <div class="mt-4 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg">
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
          <strong>Error Code:</strong> 500 Internal Server Error
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
          <strong>Timestamp:</strong>
          <span id="timestamp"></span>
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <strong>Request ID:</strong>
          <span id="requestId"></span>
        </p>
      </div>
    </details>
  </div>
</BaseLayout>

<script>
  // Add timestamp and request ID
  const timestampElement = document.getElementById("timestamp");
  const requestIdElement = document.getElementById("requestId");

  if (timestampElement) {
    timestampElement.textContent = new Date().toISOString();
  }

  if (requestIdElement) {
    requestIdElement.textContent = Math.random()
      .toString(36)
      .substr(2, 9)
      .toUpperCase();
  }
</script>

<style>
  .slide-in {
    opacity: 0;
    animation: content-in 0.5s 0.3s ease-out forwards;
  }

  @keyframes content-in {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
